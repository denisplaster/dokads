# Neon Postgres. Vercel's Neon integration injects this automatically in
# preview + production. For local dev, create a Neon *branch* and paste its
# pooled connection string here — do not point local dev at production.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5190"

# Only read by `npm run admin:create`, never committed and never stored in the
# database in plain text. Choose your own — unset both after the account exists.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Local shortcut: an in-process Postgres, no account or daemon needed.
# DATABASE_URL="pglite://.data/dev"

# NOTE on pglite://: it is a single-process file database. Do not run
# `npm run dev` and `npm run build` against it at the same time — concurrent
# writers corrupt the directory. Delete .data and re-seed if that happens.
# Point DATABASE_URL at a Neon branch to avoid the constraint entirely.

# --- Email (optional) -------------------------------------------------------
# Without these the site works exactly as it does now: registrations and joins
# are recorded, but nobody is notified and admin password reset will not work.
#
# ONLY RESEND_API_KEY IS REQUIRED. akconnection.com is verified in Resend, and
# the code already defaults to sending from (and replying to) that domain.
RESEND_API_KEY=""
# Optional overrides. The FROM domain must be verified in Resend or every send
# is rejected — dokads.com is NOT verified, so do not use it here yet.
# EMAIL_FROM="DOKADS <dokads@akconnection.com>"     # this is the default
# EMAIL_REPLY_TO="dokads@akconnection.com"         # this is the default
# Get an email when someone registers, joins, or writes in. Optional.
ADMIN_NOTIFY_EMAIL=""
